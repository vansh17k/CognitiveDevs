<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <rect width="600" height="400" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="20" y="20" width="560" height="360" rx="12" fill="#ffffff" stroke="#e2e8f0"/>
  <rect x="40" y="40" width="520" height="60" rx="8" fill="#0d4734"/>
  <text x="300" y="78" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#ffffff" text-anchor="middle">PRINCIPAL DISPLAY PANEL (PDP) - FRONT</text>
  
  <!-- Product details box -->
  <rect x="40" y="120" width="300" height="220" rx="8" fill="#f1f5f9" stroke="#cbd5e1"/>
  <text x="60" y="155" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#0f172a">PREMIUM ROASTED ALMONDS</text>
  <text x="60" y="185" font-family="Arial, sans-serif" font-size="13" fill="#475569">Generic Name: Edible Nut Kernels</text>
  <text x="60" y="210" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#0d4734">Net Quantity: 500 g</text>
  <text x="60" y="235" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#b91c1c">MRP: ₹450.00 (Incl. of all taxes)</text>
  <text x="60" y="260" font-family="Arial, sans-serif" font-size="12" fill="#64748b">Unit Sale Price: ₹0.90 / g</text>
  <text x="60" y="285" font-family="Arial, sans-serif" font-size="12" fill="#059669">FSSAI Lic. No: 10020021001234</text>

  <!-- Visual graphic -->
  <rect x="360" y="120" width="200" height="220" rx="8" fill="#fef3c7" stroke="#fcd34d"/>
  <circle cx="460" cy="210" r="50" fill="#f59e0b" opacity="0.4"/>
  <text x="460" y="215" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#92400e" text-anchor="middle">Sample Label Front</text>
  <text x="460" y="235" font-family="monospace" font-size="11" fill="#78350f" text-anchor="middle">500g Pack</text>
