{
  "entities": {
    "inspections": {
      "description": "Stores statutory packaging verification audits and inspection reports",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique verification audit ID"
        },
        "productName": {
          "type": "string",
          "description": "Name of the packaged commodity"
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or brand name"
        },
        "category": {
          "type": "string",
          "description": "Commodity category (Snacks, Dairy, Confectionery, Groceries, etc.)"
        },
        "mrp": {
          "type": "string",
          "description": "Maximum Retail Price as declared on package"
        },
        "netQuantity": {
          "type": "string",
          "description": "Declared net weight/volume"
        },
        "complianceScore": {
          "type": "number",
          "description": "PCR-2011 compliance score out of 100"
        },
        "status": {
          "type": "string",
          "description": "Compliant, Non-Compliant, or Pending Review"
        },
        "violationsCount": {
          "type": "number",
          "description": "Total statutory violations detected"
        },
        "scannedByRole": {
          "type": "string",
          "description": "Role executing the scan: inspector, consumer, fbo"
        },
        "isConsumerScan": {
          "type": "boolean",
          "description": "Flag for public consumer zero-retention verification"
        },
        "inspectorName": {
          "type": "string",
          "description": "Officer or verifier attribution"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of scan"
        }
      },
      "required": ["id", "productName", "complianceScore", "status", "timestamp"]
    },
    "notices": {
      "description": "Form LM-1 statutory compliance violation notices generated by inspectors",
      "properties": {
        "noticeId": {
          "type": "string",
          "description": "Notice registration ID"
        },
        "inspectionId": {
          "type": "string",
          "description": "Linked inspection record"
        },
        "violatorName": {
          "type": "string",
          "description": "Manufacturer or Packer Name"
        },
        "section": {
          "type": "string",
          "description": "Legal Metrology Act Section (e.g., Section 36)"
        },
        "hearingDate": {
          "type": "string",
          "description": "Scheduled compounding or compliance response date"
        },
        "status": {
          "type": "string",
          "description": "Draft, Issued, or Compounded"
        }
      },
      "required": ["noticeId", "inspectionId", "violatorName", "status"]
    }
  },
  "firestore": {
    "/inspections/{inspectionId}": {
      "schema": "inspections",
      "description": "Statutory verification inspection audit records"
    },
    "/notices/{noticeId}": {
      "schema": "notices",
      "description": "Form LM-1 legal enforcement notices"
    }
  }
}
